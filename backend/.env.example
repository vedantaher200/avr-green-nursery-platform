# AVRGREEN Backend — Environment Configuration
# ============================================================
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME=AVRGREEN

# ── Database (PostgreSQL) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=avrgreen_user
# Must match docker-compose.yml when using the bundled local stack.
DB_PASSWORD=avrgreen_local_pass
DB_NAME=avrgreen_db
DB_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=avrgreen_access_secret_change_in_production_512bits
JWT_REFRESH_SECRET=avrgreen_refresh_secret_change_in_production_512bits
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudflare R2 Storage ────────────────────────────────────
R2_ACCOUNT_ID=your_cf_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=avrgreen-assets
R2_PUBLIC_URL=https://assets.avrgreen.com

# ── Razorpay Payment Gateway ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Email (SMTP / Nodemailer) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@avrgreen.com
SMTP_PASS=your_smtp_password
SMTP_FROM="AVRGREEN Nursery <no-reply@avrgreen.com>"

# ── SMS (Twilio / MSG91) ──────────────────────────────────────
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+14155238886

# ── Push Notifications (Firebase) ────────────────────────────
FCM_SERVER_KEY=your_firebase_server_key

# ── Monitoring ────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
